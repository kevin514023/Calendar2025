<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <title>2025 可編輯行事曆</title>
  <style>
    body {
      font-family: sans-serif;
      margin: 20px;
    }
    h1 {
      text-align: center;
    }
    .month {
      margin: 30px 0;
    }
    .month-name {
      font-size: 24px;
      margin-bottom: 10px;
    }
    .calendar {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 1px;
      background: #ccc;
    }
    .day {
      background: #fff;
      min-height: 100px;
      padding: 5px;
      display: flex;
      flex-direction: column;
      font-size: 14px;
    }
    .day.holiday {
      background: #ffe5e5;
    }
    .day-header {
      font-weight: bold;
    }
    textarea {
      flex-grow: 1;
      resize: none;
      border: none;
      margin-top: 5px;
      font-family: sans-serif;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <h1>2025 可編輯個人行事曆</h1>
  <div id="calendar"></div>

  <script>
    const calendarEl = document.getElementById('calendar');
    const extraHolidays = [
      "2025-01-01",
      "2025-01-25", "2025-01-26", "2025-01-27", "2025-01-28", "2025-01-29", "2025-01-30", "2025-01-31",
      "2025-02-01", "2025-02-02",
      "2025-02-28", "2025-03-01", "2025-03-02",
      "2025-04-03", "2025-04-04", "2025-04-05", "2025-04-06",
      "2025-05-01",
      "2025-05-30", "2025-05-31", "2025-06-01",
      "2025-10-04", "2025-10-05", "2025-10-06",
      "2025-10-10", "2025-10-11", "2025-10-12",
      "2025-02-08", "2025-06-13", "2025-07-18", "2025-08-15", "2025-09-12", "2025-11-07", "2025-12-31"
    ];

    function isWeekend(year, month, day) {
      const date = new Date(year, month - 1, day);
      return date.getDay() === 0 || date.getDay() === 6;
    }

    function loadNote(dateStr) {
      return localStorage.getItem('note-' + dateStr) || '';
    }

    function saveNote(dateStr, value) {
      localStorage.setItem('note-' + dateStr, value);
    }

    function createMonth(month, year) {
      const firstDay = new Date(year, month - 1, 1);
      const lastDay = new Date(year, month, 0);
      const totalDays = lastDay.getDate();
      const offset = firstDay.getDay();

      const monthDiv = document.createElement('div');
      monthDiv.className = 'month';

      const title = document.createElement('div');
      title.className = 'month-name';
      title.textContent = `${year}年 ${month}月`;
      monthDiv.appendChild(title);

      const cal = document.createElement('div');
      cal.className = 'calendar';

      ['日', '一', '二', '三', '四', '五', '六'].forEach(day => {
        const header = document.createElement('div');
        header.className = 'day day-header';
        header.textContent = day;
        cal.appendChild(header);
      });

      for (let i = 0; i < offset; i++) {
        const empty = document.createElement('div');
        empty.className = 'day';
        cal.appendChild(empty);
      }

      for (let day = 1; day <= totalDays; day++) {
        const dateStr = `${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
        const dateObj = new Date(year, month - 1, day);
        const dayEl = document.createElement('div');
        dayEl.className = 'day';

        if (isWeekend(year, month, day) || extraHolidays.includes(dateStr)) {
          dayEl.classList.add('holiday');
        }

        const label = document.createElement('div');
        label.textContent = day;
        dayEl.appendChild(label);

        const ta = document.createElement('textarea');
        ta.value = loadNote(dateStr);
        ta.onchange = () => saveNote(dateStr, ta.value);
        dayEl.appendChild(ta);

        cal.appendChild(dayEl);
      }

      monthDiv.appendChild(cal);
      calendarEl.appendChild(monthDiv);
    }

    for (let m = 1; m <= 12; m++) {
      createMonth(m, 2025);
    }
  </script>
</body>
</html>
